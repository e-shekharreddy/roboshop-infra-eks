# Local .terraform directories (cache & providers)
.terraform/

# Terraform state files (contain sensitive data and state locks)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables files across all environments
*.tfvars
*.tfvars.json

# Exclude local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore plan output files
*tfplan*
planout

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Graph outputs
*.dot